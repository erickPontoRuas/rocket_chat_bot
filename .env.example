# Ambiente da aplicacao: development | test | production
NODE_ENV=development
LOG_LEVEL=info

# Rocket.Chat (host sem barra final)
ROCKETCHAT_URL=https://chat.exemplo.com
ROCKETCHAT_USER=bot
ROCKETCHAT_PASSWORD=
ROCKETCHAT_ROOM_ID=

# Redis
REDIS_URL=redis://localhost:6379
CONVERSATION_TTL_SECONDS=86400

# GitHub (fine-grained PAT com Issues: Read and write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_LABELS=

# OpenAI (avaliacao das mensagens e geracao de respostas)
OPENAI_API_KEY=
