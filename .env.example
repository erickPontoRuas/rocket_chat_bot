# Ambiente da aplicacao: development | test | production
NODE_ENV=development
LOG_LEVEL=info

# Rocket.Chat (host sem barra final)
ROCKETCHAT_URL=https://chat.exemplo.com
ROCKETCHAT_USER=bot
ROCKETCHAT_PASSWORD=
ROCKETCHAT_ROOM_ID=

# Redis
REDIS_URL=redis://localhost:6379
CONVERSATION_TTL_SECONDS=86400

# GitHub (fine-grained PAT com Issues: Read and write)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Apenas labels fixas; ATRAPALHA/PERDE VENDA são definidas pelo nível respondido
GITHUB_LABELS=

# OpenAI (avaliacao do relato, normalizacao de nivel e titulo da issue)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_TIMEOUT_MS=30000
